# Copy to .env.local (never commit .env.local).

# Supabase (Project settings -> API). Anon/publishable key is safe in the browser because of RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key: server only. Set it in Vercel env vars, never in the repo or chat.
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans (Sandbox first: Settings -> Access keys)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# JPY -> IDR rate used to charge through Midtrans. Confirm with Finance. Required for checkout.
FX_JPY_IDR=
# Flat shipping in JPY (0 until Procurement & Logistics confirms).
SHIPPING_FLAT_JPY=0
